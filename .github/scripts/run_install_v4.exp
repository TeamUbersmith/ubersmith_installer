#!/usr/bin/env expect -f
#
# Drives install_ubersmith.sh through its interactive vars_prompt questions
# for CI, targeting ubersmith_major_version=4 specifically.
#
# This is a copy of run_install.exp with only the version answer changed
# (that script hardcodes "5\r" for the "Choose which version of Ubersmith
# to install (4 or 5)" prompt). Used by the upgrade-compatibility workflow
# to seed an old, real major-4 Ansible install that the new Python CLI's
# `upgrade` command must then be able to upgrade in place.
#
# Test installs never request a Let's Encrypt certificate. Requires
# UBERSMITH_INTERACTIVE=false in the environment so pause prompts are skipped.

set timeout 1800
spawn ./install_ubersmith.sh

expect "Choose which version of Ubersmith to install (4 or 5)"
send "4\r"

expect "Choose an installation directory for Ubersmith"
send "\r"

expect "Should the installer request a security certificate from Let's Encrypt?"
send "no\r"

expect "Enter the hostname(s) where you will be hosting Ubersmith"
send "ubersmith.ci.test\r"

expect "Enter the email address of the Ubersmith administrator"
send "ci-test@ubersmith.com\r"

expect eof
catch wait result
exit [lindex $result 3]
